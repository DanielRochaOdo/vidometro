# API Odontoart
# Aceita apenas a origem (https://api.exemplo.com) ou a URL completa
# https://api.exemplo.com/v2/api/contratos/vidasAtivas
VIDAS_ATIVAS_API_ENDPOINT=
VIDAS_ATIVAS_API_TOKEN=
